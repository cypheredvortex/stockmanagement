<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

    <style>
        /* Global Styles */
        body {
            font-family: "Roboto", sans-serif;
            margin: 0;
            padding: 0;
            background: #f9fafb;
            color: #1f2937;
            display: flex;
            min-height: 100vh;
        }

        .dashboard {
            display: flex;
            width: 100%;
            position: relative;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            height: 100vh;
            background: #111827;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            position: fixed;
            left: 0;
            top: 0;
            box-shadow: 4px 0 12px rgba(0, 0, 0, 0.1);
        }

        .sidebar h2 {
            color: #f9fafb;
            text-align: center;
            font-size: 1.8em;
            margin-bottom: 40px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
        }

        .sidebar ul li {
            margin-bottom: 20px;
        }

        .sidebar ul li a {
            color: #d1d5db;
            text-decoration: none;
            font-size: 1em;
            padding: 12px 18px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            transition: 0.3s;
        }

        .sidebar ul li a i {
            margin-right: 12px;
        }

        .sidebar ul li a:hover {
            background: #2563eb;
            color: #ffffff;
        }

        /* Main Content */
        .main-content {
            margin-left: 270px;
            padding: 40px;
            width: 100%;
            background: #f3f4f6;
        }

        h2 {
            font-size: 2em;
            margin-bottom: 20px;
        }

        /* Cards */
        .row.g-3 {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .col-md-3 {
            flex: 1;
            max-width: 22%;
        }

        .card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        .card-body {
            padding: 20px;
        }

        .card-title {
            font-size: 1.2em;
            margin-bottom: 15px;
        }

        .card-text {
            font-size: 1em;
        }

        /* Chart Section */
        .row.g-3 {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .col-md-6 {
            flex: 1;
            max-width: 48%;
        }

        canvas {
            width: 100%;
            height: 300px;
        }

        /* Media Queries */
        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .main-content {
                margin-left: 0;
                padding: 20px;
            }

            .dashboard {
                flex-direction: column;
            }

            .col-md-3,
            .col-md-6 {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid dashboard">
        <div class="sidebar">
            <h2>Gestion des Stocks</h2>
            <ul>
                <li><a href="{% url 'dashboard_view' %}"><i class="fas fa-box"></i> Dashboard</a></li>
                <li><a href="{% url 'get_stocks' %}"><i class="fas fa-box"></i> Stocks</a></li>
                <li><a href="{% url 'get_articles' %}"><i class="fas fa-file-alt"></i> Articles</a></li>
                <li><a href="{% url 'get_rapports' %}"><i class="fas fa-chart-line"></i> Rapports</a></li>
                <li><a href="{% url 'gethistorique_view' %}"><i class="fas fa-history"></i> Historique</a></li>
                <li><a href="{% url 'logout_view' %}" class="logout"><i class="fas fa-sign-out-alt"></i> Se Déconnecter</a></li>
            </ul>
        </div>

        <div class="main-content">
            <h2>Dashboard Overview</h2>

            <!-- Four Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Total Revenue</h5>
                            <p class="card-text">{{ total_revenue }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Total Orders</h5>
                            <p class="card-text">{{ total_orders }} Orders</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Total Stock Quantity</h5>
                            <p class="card-text">{{ total_stock_qty }} items</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Sales Growth</h5>
                            <p class="card-text">{{ sales_growth }}%</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="row g-3">
                <!-- Revenue -->
                <div class="col-md-6">
                    <h3 class="my-4">Revenue</h3>
                    <div class="card">
                        <div class="card-body">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Stock Movements -->
                <div class="col-md-6">
                    <h3 class="my-4">Stock Movements</h3>
                    <div class="card">
                        <div class="card-body">
                            <canvas id="stockMovementsChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Articles -->
                <div class="col-md-6">
                    <h3 class="my-4">Articles</h3>
                    <div class="card">
                        <div class="card-body">
                            <canvas id="articlesChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Growth Potential -->
                <div class="col-md-6">
                    <h3 class="my-4">Growth Potential</h3>
                    <div class="card">
                        <div class="card-body">
                            <canvas id="growthPotentialChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart Scripts -->
            <canvas id="revenueChart"></canvas>
    <script>
        var revenueCtx = document.getElementById('revenueChart').getContext('2d');
        var revenueChart = new Chart(revenueCtx, {
            type: 'line',  // or 'bar', 'line', 'pie', etc.
            data: {
                labels: {{ revenue_labels|safe }},
                datasets: [{
                    label: 'Revenue',
                    data: {{ revenue_values|safe }},
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: false
                }]
            }
        });
    </script>

    <!-- Stock Movements Chart -->
    <canvas id="stockMovementsChart"></canvas>
    <script>
        var stockCtx = document.getElementById('stockMovementsChart').getContext('2d');
        var stockMovementsChart = new Chart(stockCtx, {
            type: 'line',
            data: {
                labels: {{ stock_labels|safe }},
                datasets: [{
                    label: 'Stock Movements',
                    data: {{ stock_values|safe }},
                    borderColor: 'rgba(255, 99, 132, 1)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    fill: false
                }]
            }
        });
    </script>

    <!-- Articles Demand Chart -->
    <canvas id="revenueChart"></canvas>
    <canvas id="stockChart"></canvas>
    <canvas id="articlesChart"></canvas>
    <canvas id="growthChart"></canvas>
    <script>
        const revenueData = {{ revenue_data|safe }};
        const stockMovementsData = {{ stock_movements_data|safe }};
        const articlesData = {{ articles_data|safe }};
        const growthPotentialData = {{ growth_potential_data|safe }};
    
        // Revenue Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: revenueData.map(item => item.dateCommande),
                datasets: [{
                    label: 'Revenue',
                    data: revenueData.map(item => item.revenue),
                    borderColor: 'rgba(75, 192, 192, 1)',
                    fill: false,
                }]
            }
        });
    
        // Stock Movement Chart
        const stockCtx = document.getElementById('stockChart').getContext('2d');
        new Chart(stockCtx, {
            type: 'bar',
            data: {
                labels: stockMovementsData.map(item => item.date),
                datasets: [{
                    label: 'Stock Movements',
                    data: stockMovementsData.map(item => item.movement),
                    backgroundColor: 'rgba(153, 102, 255, 0.6)',
                }]
            }
        });
    
        // Articles Demand Chart
        const articlesCtx = document.getElementById('articlesChart').getContext('2d');
        new Chart(articlesCtx, {
            type: 'bar',
            data: {
                labels: articlesData.map(item => item.nom),
                datasets: [{
                    label: 'Demand',
                    data: articlesData.map(item => item.demand),
                    backgroundColor: 'rgba(255, 159, 64, 0.6)',
                }]
            }
        });
    
        // Growth Potential Chart
        const growthCtx = document.getElementById('growthChart').getContext('2d');
        new Chart(growthCtx, {
            type: 'bar',
            data: {
                labels: growthPotentialData.map(item => item.nom),
                datasets: [{
                    label: 'Growth Potential',
                    data: growthPotentialData.map(item => item.growth),
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                }]
            }
        });
    </script>
    
    </div>

</body>
</html>
